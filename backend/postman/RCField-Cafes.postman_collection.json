            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/cafes/00000000-0000-0000-0000-000000000000",
              "host": ["{{base_url}}"],
              "path": ["cafes", "00000000-0000-0000-0000-000000000000"]
            }
          }
        }
      ]
