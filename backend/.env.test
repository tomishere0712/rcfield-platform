NODE_ENV=test
PORT=3001

DB_HOST=localhost
DB_PORT=5435
DB_NAME=rcfeild_test
DB_USERNAME=postgres
DB_PASSWORD=postgres

JWT_SECRET=test-jwt-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=test-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

PLATFORM_FEE_PCT=0.15
PAYMENT_WINDOW_MINUTES=30
SLOT_LOCK_TTL_SECONDS=1800
# Non-secret test credentials let payment URL tests exercise the VNPay signing flow
# without calling the external gateway.
VNPAY_TMN_CODE=test-vnpay-tmn-code
VNPAY_HASH_SECRET=test-vnpay-hash-secret
GOOGLE_CLIENT_ID=test-google-client-id
EMAIL_PROVIDER=Brevo
EMAIL_BREVO_API_KEY=test-brevo-api-key
EMAIL_BREVO_BASE_URL=https://api.brevo.com/v3
EMAIL_FROM_EMAIL=no-reply@test.rcfield.vn
EMAIL_FROM_NAME=RCField Test
PASSWORD_RESET_CODE_TTL_MINUTES=30

# Ngân hàng mô phỏng — bật trong test để kiểm cả trang thanh toán giả lập
SANDBOX_BANK_ENABLED=true
BANK_WEBHOOK_API_KEY=test-bank-webhook-key
