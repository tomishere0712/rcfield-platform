        {
          "name": "Danh sách xe phẳng — Customer / Guest (Lọc RETIRED và Ẩn maintenance date)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let res;",
                  "try { res = pm.response.json(); } catch(e) { res = {}; }",
                  "pm.test('Status 200 OK', () => {",
                  "  if (pm.response.code !== 200) {",
                  "    pm.expect.fail('Status code ' + pm.response.code + '. Error: ' + (res.message || JSON.stringify(res)));",
                  "  }",
                  "});",
                  "pm.test('Retired units are hidden', () => {",
                  "  pm.expect(res.data).to.be.an('array');",
                  "  const retired = res.data.filter(u => u.status === 'RETIRED');",
                  "  pm.expect(retired.length).to.eql(0);",
                  "});",
                  "pm.test('last_maintenance_at is hidden', () => {",
                  "  res.data.forEach(u => {",
                  "    pm.expect(u.lastMaintenanceAt).to.be.undefined;",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
