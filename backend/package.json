{
  "name": "rcfeild-be",
  "version": "1.0.0",
  "description": "RCField Backend — Express + TypeScript + TypeORM",
  "main": "dist/app.js",
  "scripts": {
    "dev": "node scripts/kill-port.js 3000 && nodemon",
    "swagger": "npm run dev",
    "up:all": "node scripts/up-all.js",
    "nlu:install": "python3 -m venv nlu-service/.venv && nlu-service/.venv/bin/pip install -r nlu-service/requirements.txt && nlu-service/.venv/bin/python -c \"from sentence_transformers import SentenceTransformer; print('[NLU] Downloading model...'); SentenceTransformer('paraphrase-multilingual-MiniLM-L12-v2'); print('[NLU] Model ready.')\"",
    "nlu": "lsof -ti:8000 | xargs kill -9 2>/dev/null; nlu-service/.venv/bin/python -m uvicorn main:app --port 8000 --reload --app-dir nlu-service",
    "ui": "lsof -ti:5500 | xargs kill -9 2>/dev/null; python3 -m http.server 5500 --directory .",
    "db-view": "docker compose run --rm schemaspy",
    "build": "tsc",
    "start": "node dist/server.js",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/config/database.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/config/database.ts --transaction each",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/database.ts --transaction each",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "setup": "npm run migration:run && npm run seed",
    "seed": "ts-node --transpile-only src/seeds/seed-users.ts",
    "seed:cafes": "ts-node --transpile-only src/seeds/seed-cafes.ts",
    "seed:payment-settings": "ts-node --transpile-only src/seeds/seed-payment-settings.ts",
    "seed:menu": "ts-node --transpile-only src/seeds/seed-menu.ts",
    "seed:operations": "ts-node --transpile-only src/seeds/seed-operations.ts",
    "seed:contests": "ts-node --transpile-only src/seeds/seed-contests.ts",
    "seed:commercial": "ts-node --transpile-only src/seeds/seed-commercial-data.ts",
    "seed:demo-july19": "ts-node --transpile-only src/seeds/seed-demo-july19-contest.ts",
    "seed:racing-network": "ts-node --transpile-only src/seeds/seed-racing-network.ts",
    "seed:all": "npm run seed && npm run seed:cafes && npm run seed:payment-settings && npm run seed:menu && npm run seed:operations && npm run seed:contests && npm run seed:commercial && npm run seed:racing-network",
    "seed:system-cafe": "ts-node --transpile-only src/scripts/seed-system-cafe.ts",
    "seed:contest-entrants": "ts-node --transpile-only src/scripts/seed-contest-entrants.ts",
    "reset:bookings": "ts-node --transpile-only src/scripts/reset-bookings.ts",
    "audit:pending-refunds": "ts-node --transpile-only src/scripts/audit-pending-refunds.ts",
    "test:kb": "ts-node --transpile-only src/scripts/test-kb.ts",
    "test:staff-customer-flow": "ts-node --transpile-only src/scripts/test-staff-customer-flow.ts",
    "test:staff-flow": "npm run test:staff-customer-flow",
    "test": "sh scripts/run-jest.sh",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "api:coverage": "node scripts/api-coverage.js",
    "api:contract": "node scripts/check-api-contract.js ../rcfield-fe",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prepare": "husky",
    "purge": "ts-node --transpile-only src/scripts/purge-data.ts"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@google/genai": "^2.5.0",
    "@google/generative-ai": "^0.24.1",
    "@payos/node": "^2.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/pdfmake": "^0.3.3",
    "@types/qrcode": "^1.5.6",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.79.1",
    "cloudinary": "^2.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-list-endpoints": "^7.1.1",
    "express-rate-limit": "^7.3.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "node-ical": "^0.26.1",
    "pdf-parse": "^2.4.5",
    "pdfmake": "^0.3.10",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0",
    "winston": "^3.19.0",
    "ws": "^8.20.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-list-endpoints": "^6.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.59.3"
  }
}
