# ============================================================================
# Env template cho deploy trên Coolify / VPS
# Copy thành .env.coolify, điền giá trị thật, rồi paste vào Coolify UI.
# .env.coolify đã được gitignore.
# ============================================================================

# App
NODE_ENV=production
PORT=3000

# Database
# Copy nguyên giá trị "Postgres URL (internal)" từ Coolify UI vào đây.
DATABASE_URL=postgres://rcfield:<password>@<internal-postgres-host>:5432/rcfield

# JWT - tạo bằng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<chuỗi-bí-mật-dài>
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=<chuỗi-bí-mật-khác>
JWT_REFRESH_EXPIRES_IN=7d

# Redis (dịch vụ redis-database-rcfield trong Coolify)
# Lấy "Redis URL (internal)" từ Coolify UI, rồi tách host/port/password ra.
REDIS_HOST=<internal-redis-host>
REDIS_PORT=6379
REDIS_PASSWORD=<password-lấy-từ-coolify>
REDIS_REQUIRED=false
FB_CHAT_QUEUE_ENABLED=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateway (VNPAY)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://api.rcfield.vn/api/payments/vnpay-return
VNPAY_IPN_URL=https://api.rcfield.vn/api/payments/vnpay-ipn
VNPAY_LOCALE=vn
VNPAY_CURR_CODE=VND

# Platform
PLATFORM_FEE_PCT=0.15
PAYMENT_WINDOW_MINUTES=30
SLOT_LOCK_TTL_SECONDS=1800

# Google OAuth
GOOGLE_CLIENT_ID=<google-client-id>

# Email (Brevo)
EMAIL_PROVIDER=Brevo
EMAIL_BREVO_API_KEY=<brevo-api-key>
EMAIL_BREVO_BASE_URL=https://api.brevo.com/v3
EMAIL_FROM_EMAIL=no-reply@rcfield.vn
EMAIL_FROM_NAME=RCField
PASSWORD_RESET_CODE_TTL_MINUTES=30

# AI Chat (Gemini)
GOOGLE_API_KEY=<gemini-api-key>
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_MODEL=gemini-2.5-pro
GOOGLE_SUPPORT_MODEL=gemini-2.5-flash

# NLU Service
NLU_SERVICE_URL=http://157.66.24.92:8000
NLU_TIMEOUT_MS=2000

# ============================================================================
# Biến bổ sung dùng cho Coolify (không có trong .env local thông thường)
# ============================================================================

# Tự động chạy migration khi khởi động (nên bật ở production Coolify)
DB_AUTO_MIGRATE=true

# URL gốc cho frontend redirect / callback
CLIENT_URL=https://rcfield.vn
FRONTEND_URL=https://rcfield.vn

# API base URL của backend
API_BASE_URL=https://api.rcfield.vn

# Tùy chọn: bật mock VNPAY cho test
VNPAY_MOCK_ENABLED=false

# Facebook Messenger Channel (tùy chọn, bỏ trống nếu chưa dùng)
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=<chuỗi-ngẫu-nhiên>
FB_REDIRECT_URI=https://api.rcfield.vn/api/v1/channels/facebook/callback
# 64 ký tự hex. Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHANNEL_ENCRYPTION_KEY=<64-hex-chars>

# Contest Lab — dựng dữ liệu giải đấu qua API, tại /dev-tools/contest-lab
# Mặc định TẮT ở production. Bật khi cần dựng dữ liệu demo trên môi trường thật;
# dữ liệu sinh ra là dữ liệu THẬT trong DB vận hành.
DEV_TOOLS_ENABLED=false
# Khoá mở trang: /dev-tools/contest-lab?key=<khoá>. Bỏ trống = ai cũng mở được.
# Tạo: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DEV_TOOLS_TOKEN=
