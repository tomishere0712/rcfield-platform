      "name": "5. Ảnh chi nhánh",
      "description": "POST /cafes/:cafeId/images — upload qua multipart/form-data. GET và DELETE cũng được test ở đây.",
      "item": [
        {
          "name": "Danh sách ảnh",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
