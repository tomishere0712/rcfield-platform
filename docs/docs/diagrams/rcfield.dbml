// ── Auth / User ────────────────────────────────────────────

Enum AuthProvider {
  LOCAL
  GOOGLE
}

Enum UserRole {
  CUSTOMER
  PROVIDER
  STAFF
  ADMIN
}

// ── Cafe ──────────────────────────────────────────────────

Enum CafeStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

// ── Vehicle ───────────────────────────────────────────────

Enum VehicleTier {
  STANDARD
  PREMIUM
  RESTRICTED
}

Enum VehicleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

Enum MaintenanceType {
  SCHEDULED
  REPAIR
  INSPECTION
}

Enum VehicleSource {
  RENTAL
  BYOC
}

// ── Booking ───────────────────────────────────────────────

Enum BookingMode {
  SINGLE       // lượt đơn lẻ
  PACKAGE      // dùng từ gói đã mua
  SUBSCRIPTION // định kỳ
}

Enum PlayMode {
  RENTAL
  BYOC
  MIXED
}

Enum BookingSource {
  APP
  STAFF_MANUAL
  SYSTEM_SUBSCRIPTION
}

Enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

// ── Session ───────────────────────────────────────────────

Enum SessionStatus {
  CHECKED_IN
  ACTIVE
  EXTENDING
  CHECKING_OUT
  COMPLETED
  CANCELLED
}

Enum ParticipantType {
  BOOKER
  REGISTERED_USER
  WALK_IN_GUEST
}

Enum ParticipantRole {
  DRIVER
  PLAYER
  SPECTATOR
  GUARDIAN
}

Enum SessionVehicleStatus {
  ASSIGNED
  IN_USE
  RETURNED
  DAMAGED
}

// ── Inspection ────────────────────────────────────────────

Enum InspectionType {
  CHECK_IN
  CHECK_OUT
  STAFF_HANDOVER
}

Enum InspectionSubjectType {
  RENTAL_VEHICLE
  BYOC_VEHICLE
}

Enum InspectionItemStatus {
  OK
  SCRATCHED
  BROKEN
  MISSING
  DIRTY
  NEEDS_REVIEW
}

Enum PhotoAngle {
  FRONT
  BACK
  LEFT
  RIGHT
  TOP
  BOTTOM
  DETAIL
  OTHER
}

// ── Incident ──────────────────────────────────────────────

Enum IncidentType {
  RENTAL_DAMAGE
  BYOC_DAMAGE
  COLLISION
  LOST_ACCESSORY
  STAFF_HANDLING
  FACILITY
  OTHER
}

Enum IncidentStatus {
  RECORDED
  REVIEWED
  RESOLVED
  WAIVED
}

Enum ResponsibleParty {
  CUSTOMER
  PROVIDER
  STAFF
  SHARED
  UNKNOWN
}

// ── Payment ───────────────────────────────────────────────

Enum PaymentComponentType {
  SLOT_FEE
  RENTAL_FEE
  SECURITY_DEPOSIT
  EXTENSION_FEE
  DAMAGE_CHARGE
  FNB_PREORDER       // F&B pre-order gộp vào booking
  FNB_ON_SITE        // F&B tại quán (chỉ ghi nhận, không thu qua platform)
  PACKAGE_PURCHASE   // mua gói
  CONTEST_ENTRY      // phí thi đấu
}

Enum PaymentComponentStatus {
  PENDING
  HELD
  CAPTURED
  DISBURSED
  REFUNDED
  PARTIALLY_REFUNDED
}

Enum PaymentTransactionType {
  PAYMENT
  REFUND
  CAPTURE
  VOID
}

// ── Dispute ───────────────────────────────────────────────

Enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
}

Enum DisputeFavor {
  CUSTOMER
  PROVIDER
}

// ── F&B ───────────────────────────────────────────────────

Enum FnbOrderType {
  PRE_ORDER
  ON_SITE
}

Enum FnbOrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  DELIVERED
  CANCELLED
}

// ── Extension ─────────────────────────────────────────────

Enum ExtensionProposalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

// ── Package / Subscription ────────────────────────────────

Enum PackageStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

Enum CustomerPackageStatus {
  ACTIVE
  EXPIRED
  DEPLETED
  CANCELLED
}

Enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

// ── Contest ───────────────────────────────────────────────

Enum ContestStatus {
  DRAFT
  OPEN
  CLOSED
  RUNNING
  COMPLETED
  CANCELLED
}

Enum ContestRegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  CHECKED_IN
}

// ── Misc ──────────────────────────────────────────────────

Enum NotificationChannel {
  PUSH
  SMS
  EMAIL
}

Enum NotificationStatus {
  SENT
  FAILED
  PENDING
}

Enum TrustScoreReason {
  NO_SHOW
  DAMAGE_CONFIRMED
  BOOKING_STREAK
  ADMIN_ADJUSTMENT
}

Enum DiscountType {
  PERCENT
  FIXED
}

Enum PromoApplicableTo {
  ALL
  RENTAL
  BYOC
  MIXED
}

// ── SaaS / Platform ───────────────────────────────────────

Enum SaasSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

// ── KB / AI Chat ──────────────────────────────────────────

Enum KbDocumentStatus {
  PENDING   // vừa upload, chưa index
  INDEXED   // đã embed xong
  FAILED    // lỗi trong quá trình index
}

Enum KbContentType {
  POLICY
  FAQ
  ANNOUNCEMENT
  CUSTOM
}

// =========================================================
// 1. USER MANAGEMENT
// =========================================================

Table users {
  id            uuid         [pk, default: `gen_random_uuid()`]
  email         varchar(255) [not null, unique]
  phone         varchar(20)  [null]
  full_name     varchar(255) [not null]
  password_hash text         [null, note: 'NULL nếu đăng nhập Google']
  auth_provider AuthProvider [not null, default: 'LOCAL']
  role          UserRole     [not null]
  trust_score   decimal(5,2) [not null, default: 100.00, note: 'Chỉ có nghĩa với CUSTOMER (0–100)']
  is_active     boolean      [not null, default: true]
  created_at    timestamptz  [not null, default: `now()`]
  updated_at    timestamptz  [not null, default: `now()`]
  deleted_at    timestamptz  [null, note: 'Soft delete']

  Indexes {
    email [unique, name: 'idx_users_email']
    role  [name: 'idx_users_role']
  }
}

Table refresh_tokens {
  id         uuid        [pk, default: `gen_random_uuid()`]
  user_id    uuid        [not null, ref: > users.id]
  token      text        [not null, unique, note: 'Hashed token']
  expires_at timestamptz [not null, note: '7 ngày']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id [name: 'idx_refresh_tokens_user_id']
    token   [unique, name: 'idx_refresh_tokens_token']
  }
}

Table password_reset_tokens {
  id         uuid        [pk, default: `gen_random_uuid()`]
  user_id    uuid        [not null, ref: > users.id]
  token      text        [not null, unique, note: 'UUID random']
  expires_at timestamptz [not null, note: '15 phút']
  used_at    timestamptz [null, note: 'NULL = chưa dùng']
  created_at timestamptz [not null, default: `now()`]
}

// =========================================================
// 2. CAFE (CHI NHÁNH)
// =========================================================

Table cafes {
  id          uuid       [pk, default: `gen_random_uuid()`]
  provider_id uuid       [not null, ref: > users.id, note: 'PROVIDER role']
  name        varchar(255) [not null]
  slug        varchar(100) [not null, unique, note: 'VD: rcfield-quan-7']
  description text       [null]
  phone       varchar(20) [null]
  status      CafeStatus [not null, default: 'PENDING']
  cover_image_url text   [null]

  // Địa chỉ
  address    text         [not null]
  district   varchar(100) [not null]
  city       varchar(100) [not null]
  latitude   decimal(10,7) [null]
  longitude  decimal(10,7) [null]

  // Config vận hành per-branch
  operating_hours          jsonb   [not null, note: '{ mon: {open, close, is_closed}, ... }']
  track_types              text    [not null, default: '{}', note: 'text[] — DRIFT, CIRCUIT, OFFROAD']
  slot_duration_minutes    integer [not null, default: 60]
  slot_fee_rate            decimal(15,2) [not null]
  max_concurrent_bookings  integer [not null, default: 10]
  min_booking_notice_minutes integer [not null, default: 60]
  byoc_capacity            integer [not null, default: 5]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    slug               [unique, name: 'idx_cafes_slug']
    provider_id        [name: 'idx_cafes_provider_id']
    status             [name: 'idx_cafes_status']
    (city, district)   [name: 'idx_cafes_city_district']
    (latitude, longitude) [name: 'idx_cafes_location']
  }
}

Table cafe_images {
  id         uuid        [pk, default: `gen_random_uuid()`]
  cafe_id    uuid        [not null, ref: > cafes.id]
  url        text        [not null, note: 'Cloudinary URL']
  sort_order integer     [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    cafe_id [name: 'idx_cafe_images_cafe_id']
  }
}

Table cafe_closures {
  id          uuid        [pk, default: `gen_random_uuid()`]
  cafe_id     uuid        [not null, ref: > cafes.id]
  closed_date date        [not null, note: 'Ngày đóng cửa — chỉ ngày, không có giờ']
  reason      varchar(255) [null, note: 'VD: Nghỉ Tết, Bảo trì sân']
  created_by  uuid        [not null, ref: > users.id, note: 'PROVIDER hoặc ADMIN']
  created_at  timestamptz [not null, default: `now()`]

  Indexes {
    (cafe_id, closed_date) [unique, name: 'idx_cafe_closures_date']
    cafe_id [name: 'idx_cafe_closures_cafe_id']
  }
}

Table cafe_announcements {
  id         uuid         [pk, default: `gen_random_uuid()`]
  cafe_id    uuid         [not null, ref: > cafes.id]
  title      varchar(255) [not null]
  content    text         [null]
  image_url  text         [null, note: 'Cloudinary URL']
  starts_at  timestamptz  [not null, default: `now()`]
  ends_at    timestamptz  [null, note: 'NULL = hiển thị mãi']
  is_active  boolean      [not null, default: true]
  created_by uuid         [not null, ref: > users.id, note: 'PROVIDER hoặc STAFF']
  created_at timestamptz  [not null, default: `now()`]
  updated_at timestamptz  [not null, default: `now()`]

  Indexes {
    (cafe_id, is_active, starts_at) [name: 'idx_cafe_announcements_cafe_id']
  }
}

// =========================================================
// 3. STAFF
// =========================================================

Table staff_cafe_assignments {
  id          uuid        [pk, default: `gen_random_uuid()`]
  staff_id    uuid        [not null, unique, ref: > users.id, note: 'STAFF role — UNIQUE: 1 staff → 1 cafe']
  cafe_id     uuid        [not null, ref: > cafes.id]
  assigned_at timestamptz [not null, default: `now()`]
  assigned_by uuid        [not null, ref: > users.id, note: 'PROVIDER hoặc ADMIN']

  Indexes {
    staff_id [unique, name: 'idx_staff_cafe_staff_id']
    cafe_id  [name: 'idx_staff_cafe_cafe_id']
  }
}

// =========================================================
// 4. FLEET (ĐỘI XE)
// =========================================================

Table vehicles {
  id                    uuid          [pk, default: `gen_random_uuid()`]
  cafe_id               uuid          [not null, ref: > cafes.id]
  name                  varchar(255)  [not null, note: 'VD: Traxxas Slash 4x4']
  description           text          [null]
  tier                  VehicleTier   [not null]
  status                VehicleStatus [not null, default: 'AVAILABLE']
  hourly_rate           decimal(15,2) [not null]
  security_deposit      decimal(15,2) [not null]
  damage_multiplier     decimal(4,2)  [not null, default: 1.00, note: '1.0 / 1.5 / 2.0']
  compatible_track_types text         [not null, default: '{}', note: 'text[] — DRIFT/CIRCUIT/OFFROAD. Rỗng = chạy được tất cả']
  cover_image_url       text          [null]
  last_maintenance_at   timestamptz   [null]
  created_at            timestamptz   [not null, default: `now()`]
  updated_at            timestamptz   [not null, default: `now()`]
  deleted_at            timestamptz   [null, note: 'Soft delete']

  Indexes {
    cafe_id [name: 'idx_vehicles_cafe_id']
    status  [name: 'idx_vehicles_status']
    tier    [name: 'idx_vehicles_tier']
  }
}

Table vehicle_images {
  id         uuid        [pk, default: `gen_random_uuid()`]
  vehicle_id uuid        [not null, ref: > vehicles.id]
  url        text        [not null, note: 'Cloudinary URL']
  sort_order integer     [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    vehicle_id [name: 'idx_vehicle_images_vehicle_id']
  }
}

Table vehicle_maintenance_logs {
  id                  uuid            [pk, default: `gen_random_uuid()`]
  vehicle_id          uuid            [not null, ref: > vehicles.id]
  type                MaintenanceType [not null]
  description         text            [not null]
  cost                decimal(15,2)   [null]
  performed_by        uuid            [null, ref: > users.id, note: 'NULL nếu gửi ngoài bảo hành']
  performed_at        timestamptz     [not null]
  next_scheduled_at   timestamptz     [null]
  related_session_id  uuid            [null, ref: > sessions.id, note: 'Nếu phát sinh từ damage trong session']
  created_at          timestamptz     [not null, default: `now()`]

  Indexes {
    vehicle_id [name: 'idx_vehicle_maintenance_vehicle_id']
    (vehicle_id, performed_at) [name: 'idx_vehicle_maintenance_performed_at']
  }
}

Table customer_vehicles {
  id            uuid         [pk, default: `gen_random_uuid()`]
  customer_id   uuid         [not null, ref: > users.id, note: 'CUSTOMER sở hữu xe BYOC']
  brand         varchar(100) [null]
  model         varchar(100) [null]
  serial_number varchar(100) [null]
  description   text         [null]
  notes         text         [null]
  created_at    timestamptz  [not null, default: `now()`]
  updated_at    timestamptz  [not null, default: `now()`]
  deleted_at    timestamptz  [null, note: 'Soft delete']

  Indexes {
    customer_id [name: 'idx_customer_vehicles_customer_id']
  }
}

// =========================================================
// 5. PROMOTIONS (MÃ GIẢM GIÁ)
// =========================================================

Table promotions {
  id                  uuid              [pk, default: `gen_random_uuid()`]
  code                varchar(50)       [not null, unique, note: 'VD: RCFIELD2026']
  description         text              [null]
  discount_type       DiscountType      [not null]
  discount_value      decimal(15,2)     [not null]
  max_discount_amount decimal(15,2)     [null, note: 'Trần giảm cho PERCENT. NULL = không giới hạn']
  min_order_amount    decimal(15,2)     [null]
  max_uses            integer           [null, note: 'NULL = không giới hạn']
  max_uses_per_user   integer           [not null, default: 1]
  uses_count          integer           [not null, default: 0]
  applicable_to       PromoApplicableTo [not null, default: 'ALL']
  cafe_id             uuid              [null, ref: > cafes.id, note: 'NULL = global toàn chuỗi']
  starts_at           timestamptz       [not null]
  expires_at          timestamptz       [null]
  is_active           boolean           [not null, default: true]
  created_by          uuid              [not null, ref: > users.id]
  created_at          timestamptz       [not null, default: `now()`]
  updated_at          timestamptz       [not null, default: `now()`]

  Indexes {
    code       [unique, name: 'idx_promotions_code']
    cafe_id    [name: 'idx_promotions_cafe_id']
    expires_at [name: 'idx_promotions_expires_at']
  }
}

Table promotion_usages {
  id             uuid          [pk, default: `gen_random_uuid()`]
  promotion_id   uuid          [not null, ref: > promotions.id]
  booking_id     uuid          [not null, unique, ref: > bookings.id, note: '1 booking chỉ dùng 1 mã']
  user_id        uuid          [not null, ref: > users.id]
  discount_amount decimal(15,2) [not null]
  created_at     timestamptz   [not null, default: `now()`]

  Indexes {
    booking_id   [unique, name: 'idx_promotion_usages_booking']
    promotion_id [name: 'idx_promotion_usages_promotion_id']
    user_id      [name: 'idx_promotion_usages_user_id']
  }
}

// =========================================================
// 6. PACKAGE & SUBSCRIPTION
// =========================================================

Table packages {
  id                    uuid          [pk, default: `gen_random_uuid()`]
  cafe_id               uuid          [not null, ref: > cafes.id]
  name                  varchar(255)  [not null]
  description           text          [null]
  slot_count            integer       [not null]
  price                 decimal(15,2) [not null]
  valid_days            integer       [not null, note: 'Hạn dùng tính từ ngày mua']
  applicable_play_modes text          [not null, default: '{}', note: 'text[] — RENTAL/BYOC/MIXED']
  status                PackageStatus [not null, default: 'ACTIVE']
  created_at            timestamptz   [not null, default: `now()`]
  updated_at            timestamptz   [not null, default: `now()`]
  deleted_at            timestamptz   [null]

  Indexes {
    cafe_id [name: 'idx_packages_cafe_id']
  }
}

Table customer_packages {
  id               uuid                  [pk, default: `gen_random_uuid()`]
  package_id       uuid                  [not null, ref: > packages.id]
  customer_id      uuid                  [not null, ref: > users.id]
  remaining_slots  integer               [not null]
  purchased_at     timestamptz           [not null, default: `now()`]
  expires_at       timestamptz           [null]
  status           CustomerPackageStatus [not null, default: 'ACTIVE']
  created_at       timestamptz           [not null, default: `now()`]
  updated_at       timestamptz           [not null, default: `now()`]

  Indexes {
    customer_id [name: 'idx_customer_packages_customer_id']
    status      [name: 'idx_customer_packages_status']
  }
}

Table package_usages {
  id                  uuid        [pk, default: `gen_random_uuid()`]
  customer_package_id uuid        [not null, ref: > customer_packages.id]
  booking_id          uuid        [not null, ref: > bookings.id]
  used_slots          integer     [not null, default: 1]
  created_at          timestamptz [not null, default: `now()`]

  Indexes {
    customer_package_id [name: 'idx_package_usages_customer_package_id']
    booking_id          [name: 'idx_package_usages_booking_id']
  }
}

Table subscriptions {
  id             uuid                 [pk, default: `gen_random_uuid()`]
  cafe_id        uuid                 [not null, ref: > cafes.id]
  customer_id    uuid                 [not null, ref: > users.id]
  play_mode      PlayMode             [not null]
  track_type     varchar(50)          [not null]
  frequency_rule jsonb                [not null, note: '{ days_of_week, time, slot_count }']
  slot_count     integer              [not null, default: 1]
  starts_at      timestamptz          [not null]
  ends_at        timestamptz          [null]
  status         SubscriptionStatus   [not null, default: 'ACTIVE']
  created_at     timestamptz          [not null, default: `now()`]
  updated_at     timestamptz          [not null, default: `now()`]

  Indexes {
    cafe_id     [name: 'idx_subscriptions_cafe_id']
    customer_id [name: 'idx_subscriptions_customer_id']
    status      [name: 'idx_subscriptions_status']
  }
}

// =========================================================
// 7. BOOKINGS (ĐẶT LỊCH)
// =========================================================

Table bookings {
  id                  uuid          [pk, default: `gen_random_uuid()`]
  customer_id         uuid          [not null, ref: > users.id]
  cafe_id             uuid          [not null, ref: > cafes.id]
  booking_mode        BookingMode   [not null, default: 'SINGLE']
  play_mode           PlayMode      [not null, default: 'RENTAL']
  source              BookingSource [not null, default: 'APP']
  track_type          varchar(50)   [not null]
  status              BookingStatus [not null, default: 'PENDING']
  slot_start          timestamptz   [not null]
  slot_end            timestamptz   [not null]
  slot_count          integer       [not null, default: 1]
  payment_expires_at  timestamptz   [not null, note: 'created_at + 30 phút — cron auto-cancel']
  snapshot            jsonb         [not null, note: 'BookingSnapshot — bất biến sau khi tạo']
  promotion_id        uuid          [null, ref: > promotions.id]
  discount_amount     decimal(15,2) [null]
  subscription_id     uuid          [null, ref: > subscriptions.id]
  notes               text          [null]
  cancelled_by        uuid          [null, ref: > users.id]
  cancelled_at        timestamptz   [null]
  cancellation_reason text          [null]
  created_at          timestamptz   [not null, default: `now()`]
  updated_at          timestamptz   [not null, default: `now()`]

  Indexes {
    customer_id        [name: 'idx_bookings_customer_id']
    cafe_id            [name: 'idx_bookings_cafe_id']
    status             [name: 'idx_bookings_status']
    slot_start         [name: 'idx_bookings_slot_start']
    payment_expires_at [name: 'idx_bookings_payment_expires', note: 'WHERE status = PENDING']
    (cafe_id, track_type, slot_start, slot_end) [name: 'idx_bookings_cafe_slot']
  }
}

Table booking_participants {
  id                     uuid             [pk, default: `gen_random_uuid()`]
  booking_id             uuid             [not null, ref: > bookings.id]
  user_id                uuid             [null, ref: > users.id, note: 'NULL = walk-in guest']
  participant_type       ParticipantType  [not null]
  display_name           varchar(255)     [null]
  phone                  varchar(20)      [null]
  is_primary_responsible boolean          [not null, default: false]
  created_at             timestamptz      [not null, default: `now()`]
  updated_at             timestamptz      [not null, default: `now()`]

  Indexes {
    booking_id [name: 'idx_booking_participants_booking_id']
  }
}

Table booking_vehicles {
  id                         uuid          [pk, default: `gen_random_uuid()`]
  booking_id                 uuid          [not null, ref: > bookings.id]
  vehicle_id                 uuid          [not null, ref: > vehicles.id]
  assigned_to_participant_id uuid          [null, ref: > booking_participants.id]
  hourly_rate_snapshot       decimal(15,2) [not null, note: 'Snapshot giá tại thời điểm booking']
  security_deposit_snapshot  decimal(15,2) [not null]
  damage_multiplier_snapshot decimal(4,2)  [not null]
  created_at                 timestamptz   [not null, default: `now()`]

  Indexes {
    (booking_id, vehicle_id) [unique, name: 'idx_booking_vehicles_unique']
    booking_id               [name: 'idx_booking_vehicles_booking_id']
  }
}

// =========================================================
// 8. PAYMENT
// =========================================================

Table payment_components {
  id              uuid                     [pk, default: `gen_random_uuid()`]
  booking_id      uuid                     [not null, ref: > bookings.id]
  session_id      uuid                     [null, ref: > sessions.id]
  type            PaymentComponentType     [not null]
  amount          decimal(15,2)            [not null, note: 'Bất biến sau khi tạo']
  status          PaymentComponentStatus   [not null, default: 'PENDING']
  disbursed_to    uuid                     [null, ref: > users.id]
  disbursed_at    timestamptz              [null]
  refunded_at     timestamptz              [null]
  refunded_amount decimal(15,2)            [null]
  note            text                     [null]
  created_at      timestamptz              [not null, default: `now()`]
  updated_at      timestamptz              [not null, default: `now()`]

  Indexes {
    booking_id [name: 'idx_payment_components_booking_id']
    status     [name: 'idx_payment_components_status']
  }
}

Table payment_transactions {
  id                     uuid                    [pk, default: `gen_random_uuid()`]
  booking_id             uuid                    [not null, ref: > bookings.id]
  session_id             uuid                    [null, ref: > sessions.id]
  gateway                varchar(50)             [not null, note: 'VNPAY / MOMO / VIETQR']
  gateway_transaction_id varchar(255)            [null]
  type                   PaymentTransactionType  [not null]
  amount                 decimal(15,2)           [not null]
  status                 varchar(50)             [not null, note: 'Raw status code từ gateway']
  raw_request            jsonb                   [null]
  raw_response           jsonb                   [null]
  created_at             timestamptz             [not null, default: `now()`]

  Indexes {
    booking_id             [name: 'idx_payment_transactions_booking_id']
    gateway_transaction_id [name: 'idx_payment_transactions_gateway_txn']
  }
}

// =========================================================
// 9. SESSION (CHECK-IN / THỰC TẾ CHƠI)
// =========================================================

Table sessions {
  id                  uuid          [pk, default: `gen_random_uuid()`]
  booking_id          uuid          [not null, ref: > bookings.id]
  cafe_id             uuid          [not null, ref: > cafes.id]
  status              SessionStatus [not null, default: 'CHECKED_IN']
  checked_in_by       uuid          [not null, ref: > users.id, note: 'Staff check-in']
  checked_out_by      uuid          [null, ref: > users.id, note: 'Staff check-out']
  actual_start_at     timestamptz   [not null]
  actual_end_at       timestamptz   [null]
  planned_end_at      timestamptz   [not null]
  actual_total_amount decimal(15,2) [not null, default: 0]
  notes               text          [null]
  created_at          timestamptz   [not null, default: `now()`]
  updated_at          timestamptz   [not null, default: `now()`]

  Indexes {
    booking_id [name: 'idx_sessions_booking_id']
    cafe_id    [name: 'idx_sessions_cafe_id']
    status     [name: 'idx_sessions_status']
  }
}

Table session_participants {
  id                     uuid              [pk, default: `gen_random_uuid()`]
  session_id             uuid              [not null, ref: > sessions.id]
  booking_participant_id uuid              [null, ref: > booking_participants.id]
  user_id                uuid              [null, ref: > users.id]
  display_name           varchar(255)      [null]
  phone                  varchar(20)       [null]
  role                   ParticipantRole   [not null]
  is_primary_responsible boolean           [not null, default: false]
  checked_in_at          timestamptz       [not null]
  created_at             timestamptz       [not null, default: `now()`]
  updated_at             timestamptz       [not null, default: `now()`]

  Indexes {
    session_id [name: 'idx_session_participants_session_id']
  }
}

Table session_vehicles {
  id                         uuid                 [pk, default: `gen_random_uuid()`]
  session_id                 uuid                 [not null, ref: > sessions.id]
  booking_vehicle_id         uuid                 [null, ref: > booking_vehicles.id]
  vehicle_source             VehicleSource        [not null]
  vehicle_id                 uuid                 [null, ref: > vehicles.id, note: 'RENTAL xe']
  customer_vehicle_id        uuid                 [null, ref: > customer_vehicles.id, note: 'BYOC xe']
  assigned_to_participant_id uuid                 [null, ref: > session_participants.id]
  status                     SessionVehicleStatus [not null, default: 'ASSIGNED']
  started_at                 timestamptz          [null]
  returned_at                timestamptz          [null]
  notes                      text                 [null]
  created_at                 timestamptz          [not null, default: `now()`]
  updated_at                 timestamptz          [not null, default: `now()`]

  Indexes {
    session_id [name: 'idx_session_vehicles_session_id']
  }
}

// =========================================================
// 10. INSPECTION (KIỂM TRA XE)
// =========================================================

Table inspections {
  id                    uuid                    [pk, default: `gen_random_uuid()`]
  session_id            uuid                    [not null, ref: > sessions.id]
  session_vehicle_id    uuid                    [null, ref: > session_vehicles.id]
  type                  InspectionType          [not null]
  subject_type          InspectionSubjectType   [not null]
  performed_by          uuid                    [not null, ref: > users.id, note: 'Staff']
  pre_existing_flag     boolean                 [not null, default: false, note: 'Hư hỏng có sẵn (check-in)']
  damage_noted          boolean                 [not null, default: false, note: 'Damage mới (check-out)']
  damage_description    text                    [null]
  damage_cost_estimate  decimal(15,2)           [null]
  ai_analysis_json      jsonb                   [null, note: 'Kết quả AI phân tích ảnh (optional)']
  customer_confirmed    boolean                 [not null, default: false]
  customer_confirmed_at timestamptz             [null]
  created_at            timestamptz             [not null, default: `now()`]
  updated_at            timestamptz             [not null, default: `now()`]

  Indexes {
    session_id [name: 'idx_inspections_session_id']
  }
}

Table inspection_photos {
  id            uuid        [pk, default: `gen_random_uuid()`]
  inspection_id uuid        [not null, ref: > inspections.id]
  angle         PhotoAngle  [not null]
  url           text        [not null, note: 'Cloudinary URL']
  uploaded_by   uuid        [not null, ref: > users.id]
  metadata      jsonb       [null]
  created_at    timestamptz [not null, default: `now()`]

  Indexes {
    inspection_id [name: 'idx_inspection_photos_inspection_id']
  }
}

Table inspection_checklists {
  id            uuid                  [pk, default: `gen_random_uuid()`]
  inspection_id uuid                  [not null, ref: > inspections.id]
  item_key      varchar(100)          [not null, note: 'VD: body_scratch, tire_condition']
  item_label    varchar(255)          [not null]
  status        InspectionItemStatus  [not null]
  note          text                  [null]
  created_at    timestamptz           [not null, default: `now()`]
  updated_at    timestamptz           [not null, default: `now()`]

  Indexes {
    inspection_id [name: 'idx_inspection_checklists_inspection_id']
  }
}

// =========================================================
// 11. INCIDENT (SỰ CỐ)
// =========================================================

Table incidents {
  id                uuid              [pk, default: `gen_random_uuid()`]
  session_id        uuid              [not null, ref: > sessions.id]
  reported_by       uuid              [not null, ref: > users.id]
  type              IncidentType      [not null]
  status            IncidentStatus    [not null, default: 'RECORDED']
  occurred_at       timestamptz       [not null]
  description       text              [not null]
  estimated_amount  decimal(15,2)     [null]
  responsible_party ResponsibleParty  [not null, default: 'UNKNOWN']
  final_amount      decimal(15,2)     [null]
  resolution_note   text              [null]
  resolved_by       uuid              [null, ref: > users.id]
  resolved_at       timestamptz       [null]
  created_at        timestamptz       [not null, default: `now()`]
  updated_at        timestamptz       [not null, default: `now()`]

  Indexes {
    session_id [name: 'idx_incidents_session_id']
    status     [name: 'idx_incidents_status']
  }
}

// =========================================================
// 12. EXTENSION & DISPUTE
// =========================================================

Table extension_proposals {
  id             uuid                    [pk, default: `gen_random_uuid()`]
  session_id     uuid                    [not null, ref: > sessions.id, note: 'Thay thế booking_id từ Phase1']
  proposed_by    uuid                    [not null, ref: > users.id, note: 'Staff đề xuất gia hạn']
  duration_minutes integer               [not null]
  fee_amount     decimal(15,2)           [not null]
  status         ExtensionProposalStatus [not null, default: 'PENDING']
  responded_by   uuid                    [null, ref: > users.id, note: 'Customer phản hồi']
  responded_at   timestamptz             [null]
  created_at     timestamptz             [not null, default: `now()`]
  updated_at     timestamptz             [not null, default: `now()`]

  Indexes {
    session_id [name: 'idx_extension_proposals_session_id']
  }
}

Table disputes {
  id               uuid          [pk, default: `gen_random_uuid()`]
  booking_id       uuid          [not null, unique, ref: > bookings.id, note: 'Mỗi booking max 1 dispute']
  opened_by        uuid          [not null, ref: > users.id]
  reason           text          [not null]
  evidence_photos  text          [not null, default: '{}', note: 'text[] — Cloudinary URLs']
  status           DisputeStatus [not null, default: 'OPEN']
  resolution       text          [null]
  resolution_favor DisputeFavor  [null]
  resolved_by      uuid          [null, ref: > users.id, note: 'Admin']
  resolved_at      timestamptz   [null]
  created_at       timestamptz   [not null, default: `now()`]
  updated_at       timestamptz   [not null, default: `now()`]

  Indexes {
    booking_id [unique, name: 'idx_disputes_booking_id']
    status     [name: 'idx_disputes_status']
  }
}

// =========================================================
// 13. F&B
// =========================================================

Table menu_items {
  id           uuid          [pk, default: `gen_random_uuid()`]
  cafe_id      uuid          [not null, ref: > cafes.id]
  name         varchar(255)  [not null]
  description  text          [null]
  price        decimal(15,2) [not null]
  category     varchar(100)  [null, note: 'VD: Nước uống, Đồ ăn']
  image_url    text          [null]
  is_available boolean       [not null, default: true]
  created_at   timestamptz   [not null, default: `now()`]
  updated_at   timestamptz   [not null, default: `now()`]
  deleted_at   timestamptz   [null]

  Indexes {
    cafe_id              [name: 'idx_menu_items_cafe_id']
    (cafe_id, is_available) [name: 'idx_menu_items_available']
  }
}

Table fnb_orders {
  id           uuid           [pk, default: `gen_random_uuid()`]
  booking_id   uuid           [not null, ref: > bookings.id]
  session_id   uuid           [null, ref: > sessions.id]
  type         FnbOrderType   [not null]
  status       FnbOrderStatus [not null, default: 'PENDING']
  total_amount decimal(15,2)  [not null, default: 0]
  created_by   uuid           [not null, ref: > users.id, note: 'Customer (pre-order) hoặc Staff (on-site)']
  confirmed_by uuid           [null, ref: > users.id]
  confirmed_at timestamptz    [null]
  notes        text           [null]
  created_at   timestamptz    [not null, default: `now()`]
  updated_at   timestamptz    [not null, default: `now()`]

  Indexes {
    booking_id [name: 'idx_fnb_orders_booking_id']
    session_id [name: 'idx_fnb_orders_session_id']
  }
}

Table fnb_order_items {
  id                  uuid          [pk, default: `gen_random_uuid()`]
  order_id            uuid          [not null, ref: > fnb_orders.id]
  menu_item_id        uuid          [not null, ref: > menu_items.id]
  quantity            integer       [not null, note: 'CHECK quantity > 0']
  unit_price          decimal(15,2) [not null, note: 'Snapshot giá tại thời điểm order']
  item_name_snapshot  varchar(255)  [not null, note: 'Snapshot tên item']
  created_at          timestamptz   [not null, default: `now()`]

  Indexes {
    order_id [name: 'idx_fnb_order_items_order_id']
  }
}

// =========================================================
// 14. CONTEST (THI ĐẤU)
// =========================================================

Table contests {
  id                       uuid          [pk, default: `gen_random_uuid()`]
  provider_id              uuid          [not null, ref: > users.id]
  name                     varchar(255)  [not null]
  description              text          [null]
  track_type_id            uuid          [not null, ref: > track_types.id]
  vehicle_rule             jsonb         [not null, default: `'{}'::jsonb`, note: 'Rule rental/BYOC/spec']
  starts_at                timestamptz   [not null]
  ends_at                  timestamptz   [not null]
  registration_opens_at    timestamptz   [not null]
  registration_closes_at   timestamptz   [not null]
  capacity                 integer       [not null]
  entry_fee                decimal(15,2) [not null, default: 0]
  status                   ContestStatus [not null, default: 'DRAFT']
  banner_image_url         text          [null]
  config                   jsonb         [not null, default: `'{}'::jsonb`, note: 'format, drivers_per_match, rules_text, prizes, leaderboard']
  created_by               uuid          [not null, ref: > users.id]
  created_at               timestamptz   [not null, default: `now()`]
  updated_at               timestamptz   [not null, default: `now()`]
  deleted_at               timestamptz   [null]

  Indexes {
    (provider_id, status)                         [name: 'idx_contests_provider_status']
    (status, starts_at)                           [name: 'idx_contests_status_starts']
    (registration_opens_at, registration_closes_at) [name: 'idx_contests_registration_window']
  }
}

Table contest_cafes {
  id                 uuid        [pk, default: `gen_random_uuid()`]
  contest_id         uuid        [not null, ref: > contests.id]
  cafe_id            uuid        [not null, ref: > cafes.id]
  role               varchar(30) [not null, default: 'HOST']
  capacity_override  integer     [null]
  check_in_enabled   boolean     [not null, default: true]
  display_order      integer     [not null, default: 0]
  created_at         timestamptz [not null, default: `now()`]
  updated_at         timestamptz [not null, default: `now()`]

  Indexes {
    (contest_id, cafe_id) [unique, name: 'idx_contest_cafes_unique']
    cafe_id              [name: 'idx_contest_cafes_cafe_id']
  }
}

Table contest_registrations {
  id                         uuid                      [pk, default: `gen_random_uuid()`]
  contest_id                 uuid                      [not null, ref: > contests.id]
  user_id                    uuid                      [not null, ref: > users.id]
  participant_role_snapshot  UserRole                  [not null]
  vehicle_source             VehicleSource             [not null]
  vehicle_id                 uuid                      [null, ref: > vehicles.id, note: 'RENTAL xe optional']
  customer_vehicle_id        uuid                      [null, ref: > customer_vehicles.id, note: 'BYOC xe optional']
  status                     ContestRegistrationStatus [not null, default: 'PENDING']
  check_in_code              varchar(64)               [not null, unique]
  checked_in_cafe_id         uuid                      [null, ref: > cafes.id]
  checked_in_by              uuid                      [null, ref: > users.id]
  checked_in_at              timestamptz               [null]
  cancelled_by               uuid                      [null, ref: > users.id]
  cancelled_at               timestamptz               [null]
  cancellation_reason        text                      [null]
  metadata                   jsonb                     [not null, default: `'{}'::jsonb`]
  created_at                 timestamptz               [not null, default: `now()`]
  updated_at                 timestamptz               [not null, default: `now()`]

  Indexes {
    (contest_id, user_id)    [unique, name: 'idx_contest_registrations_unique']
    (contest_id, status)     [name: 'idx_contest_registrations_contest_status']
    user_id                  [name: 'idx_contest_registrations_user_id']
    check_in_code            [unique, name: 'idx_contest_registrations_check_in_code']
  }
}

Table contest_matches {
  id                uuid               [pk, default: `gen_random_uuid()`]
  contest_id        uuid               [not null, ref: > contests.id]
  round_no          integer            [not null]
  match_no          integer            [not null]
  name              varchar(120)       [null]
  match_type        ContestMatchType   [not null]
  status            ContestMatchStatus [not null, default: 'DRAFT']
  scheduled_at      timestamptz        [null]
  started_at        timestamptz        [null]
  ended_at          timestamptz        [null]
  next_match_id     uuid               [null, ref: > contest_matches.id]
  advancement_rule  jsonb              [not null, default: `'{}'::jsonb`]
  result_summary    jsonb              [not null, default: `'{}'::jsonb`]
  metadata          jsonb              [not null, default: `'{}'::jsonb`]
  created_by        uuid               [null, ref: > users.id]
  decided_by        uuid               [null, ref: > users.id]
  decided_at        timestamptz        [null]
  created_at        timestamptz        [not null, default: `now()`]
  updated_at        timestamptz        [not null, default: `now()`]

  Indexes {
    (contest_id, round_no, match_no) [unique, name: 'idx_contest_matches_unique']
    (contest_id, status)             [name: 'idx_contest_matches_contest_status']
    next_match_id                    [name: 'idx_contest_matches_next_match']
  }
}

Table contest_match_participants {
  id               uuid                          [pk, default: `gen_random_uuid()`]
  match_id         uuid                          [not null, ref: > contest_matches.id]
  registration_id  uuid                          [not null, ref: > contest_registrations.id]
  slot_no          integer                       [not null]
  lane             varchar(20)                   [null]
  grid_position    integer                       [null]
  seed_no          integer                       [null]
  status           ContestMatchParticipantStatus [not null, default: 'READY']
  score            decimal(10,2)                 [null]
  finish_position  integer                       [null]
  best_lap_ms      integer                       [null]
  total_time_ms    integer                       [null]
  is_winner        boolean                       [not null, default: false]
  result_note      text                          [null]
  metadata         jsonb                         [not null, default: `'{}'::jsonb`]
  created_at       timestamptz                   [not null, default: `now()`]
  updated_at       timestamptz                   [not null, default: `now()`]

  Indexes {
    (match_id, registration_id) [unique, name: 'idx_match_participants_registration']
    (match_id, slot_no)         [unique, name: 'idx_match_participants_slot']
    registration_id             [name: 'idx_match_participants_registration_id']
  }
}

Table contest_audit_logs {
  id               uuid        [pk, default: `gen_random_uuid()`]
  contest_id       uuid        [not null, ref: > contests.id]
  registration_id  uuid        [null, ref: > contest_registrations.id]
  match_id         uuid        [null, ref: > contest_matches.id]
  actor_id         uuid        [null, ref: > users.id]
  actor_role       varchar(30) [null]
  event_type       varchar(80) [not null]
  before_json      jsonb       [null]
  after_json       jsonb       [null]
  reason           text        [null]
  metadata         jsonb       [not null, default: `'{}'::jsonb`]
  created_at       timestamptz [not null, default: `now()`]

  Indexes {
    (contest_id, created_at) [name: 'idx_contest_audit_logs_contest_created']
    event_type               [name: 'idx_contest_audit_logs_event_type']
    registration_id          [name: 'idx_contest_audit_logs_registration']
    match_id                 [name: 'idx_contest_audit_logs_match']
  }
}

// =========================================================
// 15. REVIEWS
// =========================================================

Table reviews {
  id          uuid        [pk, default: `gen_random_uuid()`]
  booking_id  uuid        [not null, unique, ref: > bookings.id, note: '1 booking 1 review']
  cafe_id     uuid        [not null, ref: > cafes.id, note: 'Denormalized để query nhanh']
  customer_id uuid        [not null, ref: > users.id]
  rating      integer     [not null, note: 'CHECK rating BETWEEN 1 AND 5']
  comment     text        [null]
  is_visible  boolean     [not null, default: true]
  created_at  timestamptz [not null, default: `now()`]

  Indexes {
    booking_id                         [unique, name: 'idx_reviews_booking_id']
    (cafe_id, is_visible, created_at)  [name: 'idx_reviews_cafe_id']
  }
}

// =========================================================
// 16. NOTIFICATIONS & SYSTEM
// =========================================================

Table notification_logs {
  id         uuid                [pk, default: `gen_random_uuid()`]
  user_id    uuid                [not null, ref: > users.id]
  booking_id uuid                [null, ref: > bookings.id]
  session_id uuid                [null, ref: > sessions.id]
  type       varchar(100)        [not null, note: 'VD: BOOKING_CONFIRMED, EXTENSION_PROPOSED']
  channel    NotificationChannel [not null]
  title      varchar(255)        [not null]
  body       text                [not null]
  status     NotificationStatus  [not null, default: 'PENDING']
  error      text                [null]
  sent_at    timestamptz         [null]
  created_at timestamptz         [not null, default: `now()`]

  Indexes {
    user_id    [name: 'idx_notification_logs_user_id']
    booking_id [name: 'idx_notification_logs_booking_id']
  }
}

Table feature_flags {
  id           uuid        [pk, default: `gen_random_uuid()`]
  feature_key  varchar(100) [not null, note: 'VD: AI_CHATBOT, FNB']
  display_name varchar(255) [not null]
  description  text        [null]
  entity_type  varchar(20) [not null, default: 'GLOBAL', note: 'GLOBAL hoặc CAFE']
  entity_id    uuid        [null, ref: > cafes.id, note: 'NULL = global toàn hệ thống']
  is_enabled   boolean     [not null, default: false]
  is_trial     boolean     [not null, default: false]
  trial_ends_at timestamptz [null]
  config       jsonb       [not null, default: '{}', note: 'VD: { monthly_quota, used_this_month }']
  enabled_by   uuid        [null, ref: > users.id, note: 'ADMIN']
  enabled_at   timestamptz [null]
  note         text        [null]
  created_at   timestamptz [not null, default: `now()`]
  updated_at   timestamptz [not null, default: `now()`]

  Indexes {
    // Partial unique indexes — không thể biểu diễn trong DBML, xem migration
    // UNIQUE (feature_key, entity_id) WHERE entity_id IS NOT NULL  → per-cafe flag
    // UNIQUE (feature_key)            WHERE entity_id IS NULL      → global flag
    (entity_type, entity_id) [name: 'idx_feature_flags_entity']
  }
}

// =========================================================
// 17. TRUST SCORE
// =========================================================

Table trust_score_logs {
  id           uuid              [pk, default: `gen_random_uuid()`]
  user_id      uuid              [not null, ref: > users.id, note: 'CUSTOMER bị ảnh hưởng']
  booking_id   uuid              [null, ref: > bookings.id]
  session_id   uuid              [null, ref: > sessions.id]
  delta        decimal(5,2)      [not null, note: 'Dương = tăng, âm = giảm']
  score_before decimal(5,2)      [not null]
  score_after  decimal(5,2)      [not null]
  reason       TrustScoreReason  [not null]
  note         text              [null]
  created_by   uuid              [null, ref: > users.id, note: 'NULL = system tự động']
  created_at   timestamptz       [not null, default: `now()`]

  Indexes {
    user_id    [name: 'idx_trust_score_logs_user_id']
    booking_id [name: 'idx_trust_score_logs_booking_id']
  }
}

// =========================================================
// 18. AI CHAT / KNOWLEDGE BASE
// =========================================================

Table cafe_widget_configs {
  id               uuid        [pk, default: `gen_random_uuid()`]
  cafe_id          uuid        [not null, unique, ref: > cafes.id, note: 'UNIQUE: 1 config per cafe']
  greeting_message text        [not null, default: 'Xin chào! Tôi có thể giúp gì cho bạn?']
  welcome_message  text        [not null, default: 'Xin chào! Tôi có thể giúp gì cho bạn?']
  position         varchar(20) [not null, default: 'BOTTOM_RIGHT', note: 'BOTTOM_RIGHT / BOTTOM_LEFT']
  primary_color    varchar(20) [not null, default: '#1a73e8']
  avatar_url       text        [null]
  quick_replies    jsonb       [not null, default: '[]', note: 'text[] — gợi ý câu hỏi nhanh']
  is_enabled       boolean     [not null, default: true]
  created_at       timestamptz [not null, default: `now()`]
  updated_at       timestamptz [not null, default: `now()`]

  Indexes {
    cafe_id [unique, name: 'idx_cafe_widget_configs_cafe_id']
  }
}

Table kb_documents {
  id                uuid             [pk, default: `gen_random_uuid()`]
  cafe_id           uuid             [not null, ref: > cafes.id]
  title             varchar(255)     [not null]
  original_filename varchar(255)     [not null]
  content_type      KbContentType    [not null, default: 'CUSTOM']
  raw_content       text             [null, note: 'Text đã parse từ PDF/DOCX/TXT']
  status            KbDocumentStatus [not null, default: 'PENDING']
  created_by        uuid             [not null, ref: > users.id, note: 'PROVIDER upload']
  created_at        timestamptz      [not null, default: `now()`]
  updated_at        timestamptz      [not null, default: `now()`]
  deleted_at        timestamptz      [null, note: 'Soft delete — cascade xóa kb_chunks']

  Indexes {
    cafe_id [name: 'idx_kb_documents_cafe_id']
    status  [name: 'idx_kb_documents_status']
  }
}

Table kb_chunks {
  id          uuid        [pk, default: `gen_random_uuid()`]
  cafe_id     uuid        [not null, ref: > cafes.id, note: 'Denormalized — namespace isolation trong pgvector query']
  document_id uuid        [not null, ref: > kb_documents.id, note: 'ON DELETE CASCADE']
  chunk_text  text        [not null]
  chunk_index integer     [not null, note: 'Thứ tự chunk trong document (0-based)']
  embedding   vector(768) [null, note: 'Gemini text-embedding-004 — 768 dims. Dùng raw SQL để insert/query']
  created_at  timestamptz [not null, default: `now()`]
  updated_at  timestamptz [not null, default: `now()`]

  Indexes {
    cafe_id     [name: 'idx_kb_chunks_cafe_id']
    document_id [name: 'idx_kb_chunks_document_id']
    // IVFFlat vector index: CREATE INDEX idx_kb_chunks_embedding ON kb_chunks USING ivfflat (embedding vector_cosine_ops)
  }
}

// =========================================================
// 19. SAAS / PLATFORM
// =========================================================

Table saas_plans {
  id                    uuid          [pk, default: `gen_random_uuid()`]
  name                  varchar(100)  [not null, note: 'VD: Starter, Growth, Enterprise']
  slug                  varchar(50)   [not null, unique, note: 'VD: starter, growth']
  price_monthly         decimal(15,2) [not null, note: '0 nếu free']
  max_cafes             integer       [not null]
  max_vehicles_per_cafe integer       [not null]
  max_staff_per_cafe    integer       [not null]
  features              jsonb         [not null, default: '{}', note: 'VD: {"ai_chat": true}']
  is_active             boolean       [not null, default: true]
  created_at            timestamptz   [not null, default: `now()`]
  updated_at            timestamptz   [not null, default: `now()`]

  Indexes {
    slug      [unique, name: 'idx_saas_plans_slug']
    is_active [name: 'idx_saas_plans_active']
  }
}

Table provider_subscriptions {
  id                   uuid                   [pk, default: `gen_random_uuid()`]
  provider_id          uuid                   [not null, unique, ref: > users.id, note: 'PROVIDER role — UNIQUE: 1 sub per provider']
  plan_id              uuid                   [not null, ref: > saas_plans.id]
  status               SaasSubscriptionStatus [not null, default: 'TRIALING']
  trial_ends_at        timestamptz            [null]
  current_period_start timestamptz            [not null]
  current_period_end   timestamptz            [not null]
  cancelled_at         timestamptz            [null]
  created_at           timestamptz            [not null, default: `now()`]
  updated_at           timestamptz            [not null, default: `now()`]

  Indexes {
    provider_id [unique, name: 'idx_provider_subscriptions_provider']
    status      [name: 'idx_provider_subscriptions_status']
  }
}

Table cafe_staff {
  id          uuid        [pk, default: `gen_random_uuid()`]
  cafe_id     uuid        [not null, ref: > cafes.id]
  user_id     uuid        [not null, unique, ref: > users.id, note: 'STAFF role — UNIQUE: 1 staff → 1 cafe']
  is_active   boolean     [not null, default: true, note: 'false = đã remove khỏi cafe']
  assigned_at timestamptz [not null, default: `now()`]
  removed_at  timestamptz [null]
  created_at  timestamptz [not null, default: `now()`]
  updated_at  timestamptz [not null, default: `now()`]

  Indexes {
    user_id [unique, name: 'idx_cafe_staff_user_id']
    cafe_id [name: 'idx_cafe_staff_cafe_id']
  }
}

