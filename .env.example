# ==============================================================================
# 🌐 DEPLOY HOST (Mở comment 2 dòng dưới khi muốn dùng BE Deploy trên server)
# ==============================================================================
EXPO_PUBLIC_API_URL=https://api.rcfield.site/api/v1
EXPO_PUBLIC_ENV=production

# ==============================================================================
# 🏠 LOCAL HOST (Mặc định chạy môi trường máy cá nhân)
# ==============================================================================
# API endpoint for the backend (Sử dụng địa chỉ IP của máy tính thay vì localhost)
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000/api/v1
# EXPO_PUBLIC_ENV=development
# EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# Google OAuth Client ID for the web app authentication (dùng làm audience verify ở backend)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth Client ID cho thiết bị di động Android và iOS
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=your-ios-client-id.apps.googleusercontent.com
