# ==============================================================================
# 🌐 DÙNG DATABASE TRÊN SERVER DEPLOY (Mở comment 4 dòng dưới nếu muốn BE local dùng DB VPS)
# ==============================================================================
# DATABASE_URL=postgres://rcfield:<mat_khau_postgres>@<postgres-host>:5432/rcfield
# REDIS_HOST=<redis-host>
# REDIS_PORT=6379
# REDIS_PASSWORD=<mat_khau_redis>

# ==============================================================================
# 🏠 LOCAL HOST (Mặc định chạy môi trường máy cá nhân)
# ==============================================================================
# App
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5435
DB_NAME=rcfeild_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_REQUIRED=true
FB_CHAT_QUEUE_ENABLED=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateway (TBD)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/payments/vnpay-return
VNPAY_IPN_URL=http://localhost:3000/api/payments/vnpay-ipn
VNPAY_LOCALE=vn
VNPAY_CURR_CODE=VND
VNPAY_MOCK_ENABLED=false
# Legacy VNPay env names are also supported:
# VNP_TMN_CODE=
# VNP_HASH_SECRET=
# VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNP_RETURN_URL=http://localhost:3000/api/payments/vnpay-return
# VNP_IPN_URL=http://localhost:3000/api/payments/vnpay-ipn
# CLIENT_URL=http://localhost:5173

# Platform
PLATFORM_FEE_PCT=0.15
PAYMENT_WINDOW_MINUTES=30
SLOT_LOCK_TTL_SECONDS=1800

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email
EMAIL_PROVIDER=Brevo
EMAIL_BREVO_API_KEY=your-brevo-api-key
EMAIL_BREVO_BASE_URL=https://api.brevo.com/v3
EMAIL_FROM_EMAIL=no-reply@rcfield.vn
EMAIL_FROM_NAME=RCField
PASSWORD_RESET_CODE_TTL_MINUTES=30

# AI Chat (Gemini)
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_MODEL=gemini-2.5-pro          # complex RAG queries
GOOGLE_SUPPORT_MODEL=gemini-2.5-flash # simple/fast responses (2.0-flash da bi go, tra 404)

# NLU Service (internal Docker network — only change if running outside Docker)
NLU_SERVICE_URL=http://nlu-service:8000
NLU_TIMEOUT_MS=200

# Facebook Messenger Channel
# FB_APP_ID / FB_APP_SECRET: get from Meta Developer Console > Your App > Settings > Basic
FB_APP_ID=your-facebook-app-id
FB_APP_SECRET=your-facebook-app-secret
# FB_VERIFY_TOKEN: any random secret you choose, must match what you set in Meta Console > Webhooks
FB_VERIFY_TOKEN=your-random-webhook-verify-token
# FB_REDIRECT_URI: must match exactly what you registered in Meta Console > Facebook Login > Valid OAuth Redirect URIs
FB_REDIRECT_URI=http://localhost:3000/api/v1/channels/facebook/callback
# CHANNEL_ENCRYPTION_KEY: 64 hex chars = 32-byte AES-256 key for encrypting Page tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHANNEL_ENCRYPTION_KEY=replace-with-64-hex-chars

# PayOS Config
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

# ── Thanh toán chuyển khoản theo chi nhánh ────────────────────────────────────
# Mỗi chi nhánh có thể khai tài khoản ngân hàng riêng; khách quét mã QR và đơn
# tự xác nhận khi dịch vụ đối soát báo tiền về. Chi nhánh chưa cấu hình vẫn dùng
# cổng thanh toán chung, không đổi gì.

# Khoá dịch vụ đối soát ngân hàng gửi kèm dạng `Authorization: Apikey <key>`.
# Bắt buộc khi bật SANDBOX_BANK_ENABLED.
BANK_WEBHOOK_API_KEY=

# Ngân hàng mô phỏng — cho phép demo toàn bộ luồng khi chưa đăng ký dịch vụ đối
# soát. Quét mã QR sẽ mở một trang giả lập app ngân hàng, bấm xác nhận là hệ
# thống nhận được thông báo tiền về đúng như thật.
#
# ⚠️ BẬT = bất kỳ ai biết đường dẫn đều tự xác nhận được đơn mà không trả đồng
# nào. Chấp nhận được khi chưa có tiền thật chạy qua hệ thống.
#
# TRƯỚC KHI VẬN HÀNH THƯƠNG MẠI:
#   1. Đặt SANDBOX_BANK_ENABLED=false và kiểm mọi đường dẫn /sandbox-bank trả 404
#   2. Đăng ký dịch vụ đối soát, khai địa chỉ webhook vào trang quản trị của họ
#   3. Đổi BANK_WEBHOOK_API_KEY sang khoá của nhà cung cấp — KHÔNG dùng lại khoá
#      đã xuất hiện trong quá trình demo
#   4. Buộc mọi chi nhánh khai lại tài khoản và quét thử mã QR mẫu lần nữa
SANDBOX_BANK_ENABLED=false

# ── Contest Lab — công cụ dựng dữ liệu giải đấu ───────────────────────────────
# Trang tại /dev-tools/contest-lab dựng trọn một giải đấu bằng cách gọi đúng
# chuỗi API mà giao diện thật gọi. Nhờ vậy dữ liệu sinh ra đi qua đủ kiểm tra
# nghiệp vụ, không lệch trạng thái như khi chèn thẳng vào bảng.
#
# Mặc định bật ở mọi môi trường TRỪ production. Đặt =true nếu cần dựng dữ liệu
# demo ngay trên môi trường thật — dữ liệu sinh ra là dữ liệu THẬT, không có
# đường lùi tự động.
DEV_TOOLS_ENABLED=

# Khoá mở trang, chỉ mở được bằng /dev-tools/contest-lab?key=<khoá>.
# Bỏ trống thì trang mở tự do. Bật ở production thì NÊN khai.
# Tạo: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DEV_TOOLS_TOKEN=
# Demo/diễn tập: cho phép check-in contest ngoài khung giờ (mọi lần dùng đều có audit log).
DEV_BYPASS_CONTEST_CHECKIN=false
DEV_BYPASS_CONTEST_REGISTRATION_WINDOW=false
