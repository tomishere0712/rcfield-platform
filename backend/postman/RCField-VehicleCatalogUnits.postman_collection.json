      "name": "0. Auth & Logins",
      "description": "Logins cho từng role để lấy JWT token và lưu vào variables tương ứng.",
      "item": [
        {
          "name": "Login Provider (Owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let res;",
                  "try { res = pm.response.json(); } catch(e) { res = {}; }",
                  "pm.test('Status 200 OK', () => {",
                  "  if (pm.response.code !== 200) {",
                  "    pm.expect.fail('Status code ' + pm.response.code + '. Error: ' + (res.message || JSON.stringify(res)));",
                  "  }",
                  "});",
                  "if (res.data && res.data.access_token) {",
                  "  pm.collectionVariables.set('provider_token', res.data.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{provider_email}}\",\n  \"password\": \"{{provider_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
